{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aegisid",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/t/*/api/*", "/t/*/.well-known/*", "/healthz"]
  },
  "previews": {}
}
