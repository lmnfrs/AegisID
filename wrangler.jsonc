{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aegisid",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "vars": {
    "RP_ID": "aegis.lmnfrs.org",
    "RP_NAME": "AegisID",
    "RP_ORIGIN": "https://aegis.lmnfrs.org"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/t/*/api/*", "/t/*/.well-known/*", "/healthz", "/api/v1/dev/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "6b492111-7b13-44a4-b4fa-7ee471ae7686"
    }
  ],
  "send_email": [
		{
			"name": "EMAIL",
			"remote": true,
		},
	],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "previews": {
    "vars": {
      "RP_ID": "aegis.lmnfrs.org",
      "RP_NAME": "AegisID (preview)",
      "RP_ORIGIN": "https://*.aegis.lmnfrs.org"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "cae7cfe6-91b5-4d74-af0d-4a834b2fde61"
      }
    ],
    "send_email": [
      {
        "name": "EMAIL",
        "remote": true
      }
    ],
    "ratelimits": [
      {
        "name": "AUTH_LIMITER",
        "namespace_id": "1002",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  },
}
