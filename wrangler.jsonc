{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aegisid",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/t/*/api/*", "/t/*/.well-known/*", "/healthz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "6b492111-7b13-44a4-b4fa-7ee471ae7686"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "cae7cfe6-91b5-4d74-af0d-4a834b2fde61"
      }
    ]
  }
}
